@page
@model CeydaPortfolio.Pages.ProjectsModel
@{
    ViewData["Title"] = "GitHub Projelerim";
}

<a href="/" class="back-link">
    <i class="bi bi-arrow-left"></i>
    Ana sayfaya dön
</a>

<section id="projeler">
    <h2>GitHub Projelerim</h2>

    <div class="project-list">

        <article class="project-card">
            <h3>Hesap Makinesi Uygulaması</h3>
            <p>
                C# ile temel matematiksel işlemleri yapan basit bir uygulama.
                Kullanıcıdan sayı alıp toplama, çıkarma, çarpma ve bölme işlemleri yapıyor.
            </p>
            <div class="project-tags">
                <span>C#</span>
            </div>
            <div class="project-links">
                <a href="https://github.com/Ceygkky/Hesap-makinesi" target="_blank" rel="noopener">GitHub'da gör</a>
            </div>
        </article>

        <article class="project-card">
            <h3>Not Defteri Uygulaması</h3>
            <p>
                Kullanıcıya basit bir şekilde not yazma ve notları okuma imkanı sağlayan
                C# konsol uygulaması.
            </p>
            <div class="project-tags">
                <span>C#</span>
                <span>Konsol</span>
            </div>
            <div class="project-links">
                <a href="https://github.com/Ceygkky/NotDefteriUygulamas-" target="_blank" rel="noopener">GitHub'da gör</a>
            </div>
        </article>

        <article class="project-card">
            <h3>Günün Sözü Uygulaması</h3>
            <p>
                Her açılışta rastgele bir güzel söz gösteren küçük bir uygulama.
            </p>
            <div class="project-tags">
                <span>C#</span>
                <span>Windows Forms</span>
            </div>
            <div class="project-links">
                <a href="https://github.com/Ceygkky/GununSozu" target="_blank" rel="noopener">GitHub'da gör</a>
            </div>
        </article>

        <article class="project-card">
            <h3>Sayı Tahmin Oyunu</h3>
            <p>
                Bilgisayarın tuttuğu sayıyı tahmin etmeye dayalı bir mini oyun.
                Rastgele sayı üretimi ve kullanıcı giriş kontrolü içeriyor.
            </p>
            <div class="project-tags">
                <span>C#</span>
            </div>
            <div class="project-links">
                <a href="https://github.com/Ceygkky/Say-Bulma-Projesi" target="_blank" rel="noopener">GitHub'da gör</a>
            </div>
        </article>

    </div>
</section>
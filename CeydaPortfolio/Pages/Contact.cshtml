@page
@model CeydaPortfolio.Pages.ContactModel
@{
    ViewData["Title"] = "İletişim";
}

<a href="/" class="back-link">
    <i class="bi bi-arrow-left"></i>
    Ana sayfaya dön
</a>

<section id="iletisim">
    <h2>İletişim</h2>

    <p>
        Projeler, web geliştirme ve iş birliği hakkında formu doldurarak
        ya da e-posta ile bana ulaşabilirsiniz.
    </p>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="form-notice form-success">@Model.SuccessMessage</div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="form-notice form-error">@Model.ErrorMessage</div>
    }

    <form method="post" class="contact-form">
        <div class="form-field">
            <label asp-for="Input.Name">Adınız</label>
            <input asp-for="Input.Name" autocomplete="name" />
            <span asp-validation-for="Input.Name" class="field-error"></span>
        </div>

        <div class="form-field">
            <label asp-for="Input.Email">E-posta adresiniz</label>
            <input asp-for="Input.Email" autocomplete="email" />
            <span asp-validation-for="Input.Email" class="field-error"></span>
        </div>

        <div class="form-field">
            <label asp-for="Input.Message">Mesajınız</label>
            <textarea asp-for="Input.Message" rows="6"></textarea>
            <span asp-validation-for="Input.Message" class="field-error"></span>
        </div>

        <div class="hp-field" aria-hidden="true">
            <label asp-for="Input.Website">Bu alanı boş bırakın</label>
            <input asp-for="Input.Website" tabindex="-1" autocomplete="off" />
        </div>

        <p class="form-privacy">
            Yazdığınız bilgiler yalnızca mesajınıza dönüş yapmak için kullanılır.
        </p>

        <button type="submit" class="btn-primary-custom">
            Mesajı gönder
            <i class="bi bi-send"></i>
        </button>
    </form>

    <p class="form-alt">
        Ya da doğrudan yazın:
        <a href="mailto:cey.gokkaya0@gmail.com">cey.gokkaya0@gmail.com</a>
    </p>
</section>
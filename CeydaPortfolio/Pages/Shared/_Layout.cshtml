<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - CeydaPortfolio</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CeydaPortfolio.styles.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    

</head>
<body>

  
    <div class="side-menu">
        <div class="logo-box">
                <img src="/img/ceyd_logo.png" alt="Logo" class="logo-img">
        </div>
        <a href="/Index" class="menu-item" title="Ana Sayfa">
            <i class="bi bi-house-door-fill"></i>
        </a>
        <a href="/About" class="menu-item" title="Hakkımda">
            <i class="bi bi-person-fill"></i>
        </a>
        <a href="/Projects" class="menu-item" title="Projelerim">
            <i class="bi bi-folder-fill"></i>
        </a>
        <a href="/Contact" class="menu-item" title="İletişim">
            <i class="bi bi-envelope-fill"></i>
        </a>
    </div>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - CeydaPortfolio 
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
